# ── build artifacts this repo deliberately does not carry ───────────────────
# The staged fleet control-plane binary. `make fleet-bin FLEET=…` builds it
# from a fleet checkout into the image build context; this repo never carries
# an engine binary (see deploy/kubernetes/Containerfile.control-plane).
/deploy/kubernetes/fleet

# Image build tarballs the kind path writes.
/deploy/kubernetes/*.tar

# A local values overlay with your cluster's real names in it. Keep
# values-example.yaml generic and put your specifics here.
/deploy/kubernetes/values-local.yaml

# ── python ──────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── secrets: never, under any name ──────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig
kubeconfig.*

# ── editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── runtime output MCP servers write into this checkout ─────────────────────
# fleet spawns each stdio MCP server with its cwd set to the bundle root, so a
# relative output_dir — passed by an agent or defaulted by a server — writes
# client report files straight into this git checkout, one `git add -A` from
# being committed. The fix is fleet launching MCP subprocesses in a managed
# workspace instead of the bundle root; this is only the safety net. Rooted, so
# a legitimately tracked nested dir of the same name is unaffected.
/downloads/
/reports/
/sources/
/workspace/
/inputs/
/input/
/email_attachments/
/deal-sheets/
/mcp-shared/
/mcp-runs/
plugins/*/.plugin-data/
